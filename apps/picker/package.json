{
  "name": "sourcebook-picker",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/build-unpacked.mjs",
    "zip": "wxt zip",
    "package:local": "node scripts/package-local-test.mjs",
    "zip:store": "node scripts/zip-store.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.7.2",
    "wxt": "^0.21.4"
  }
}
